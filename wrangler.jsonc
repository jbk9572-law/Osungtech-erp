{
  // 이름/main/vars를 최상위에도 두는 건 "env 지정 없이" 배포(로컬
  // wrangler dev 등)할 때 쓰는 기본값이다 — 실제 배포는 전부 아래
  // "env" 블록(dev/production)으로 나가므로 평소엔 이 최상위 값을 볼
  // 일이 거의 없다. dev/production 값이 헷갈리지 않게, 최상위는 운영
  // 값과 동일하게 맞춰둔다(실수로 env 플래그 없이 배포해도 dev DB로
  // 잘못 나가는 사고를 피하기 위해).
  "name": "elvonix-erp",
  // 기본 OpenNext 워커(.open-next/worker.js)에 scheduled() 핸들러를 얹은
  // 커스텀 워커 — worker.ts 참고. fetch 처리는 그대로 위임되므로 앱
  // 동작에는 영향이 없고, 매일 크론(아래 triggers)만 추가로 처리한다.
  "main": "worker.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://bqetemkilbtjjbgywmbp.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJxZXRlbWtpbGJ0ampiZ3l3bWJwIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODMyMDkzNzgsImV4cCI6MjA5ODc4NTM3OH0.nUasjmfaisANmU9z_zSoQuVIryOQaZrcrT80a5vwcf0",
    "NEXT_PUBLIC_VAPID_PUBLIC_KEY": "BOc7G27LJBnLwHIDb7h7KdFk7Epk9PQHf7jt00pSqNj-wi996hCXy0ShrfIKuMbkN_8zSxGdrT6zUzeoUL8VX_k"
  },

  // ── 환경별 배포 ─────────────────────────────────────────────
  // Cloudflare 대시보드의 두 Workers 프로젝트가 각자 다른 env를 보고
  // 배포하게 한다(Settings > Build > Deploy command에
  // "npx wrangler deploy --env dev" / "--env production"을 지정 —
  // 이건 대시보드에서 설정해야 해서 코드만으론 안 됨, 체크리스트 참고).
  // 같은 git 커밋이 main으로 병합돼도 이 파일 하나로 두 환경이 서로
  // 다른 DB/이름을 보게 되므로, "dev 설정이 실수로 운영에 섞여 들어가는"
  // 사고가 파일 구조상 날 수 없다 — 병합해도 env 블록은 그대로 남고,
  // 어느 프로젝트가 어느 env로 배포하는지는 Cloudflare 쪽 설정이 결정한다.
  "env": {
    "dev": {
      "name": "elvonix-erp-dev",
      // 더미(테스트용) 직원/게시글을 매일 자동으로 채워주는 크론은
      // dev 전용 — 한국시간 새벽 6시(UTC 21:00, 전날 기준).
      "triggers": {
        "crons": ["0 21 * * *"]
      },
      "vars": {
        // 2026-10-28 작업실(dev) 전용 DB로 분리 — elvonix-erp-dev
        // (ubfarxeqaiuzizqkszcy) Supabase 프로젝트. 전에는 이 값이
        // 운영과 똑같은 bqetemkilbtjjbgywmbp를 가리키고 있어서, dev에서
        // 하던 작업/실험이 전부 운영 DB에 그대로 영향을 주고 있었다
        // (실제로 운영 DB가 dev보다 69개 마이그레이션 뒤처져 있던 사고로
        // 발견됨). 이제부터 dev 쪽 스키마 작업은 이 DB에서만 벌어진다.
        "NEXT_PUBLIC_SUPABASE_URL": "https://ubfarxeqaiuzizqkszcy.supabase.co",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InViZmFyeGVxYWl1eml6cWtzemN5Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODk5Mzc4NjQsImV4cCI6MjEwNTUxMzg2NH0.lfDuWUDY8A5R_Yx3HWDVY7sey-_vLrZsxSV3gcG2D8c",
        "NEXT_PUBLIC_VAPID_PUBLIC_KEY": "BOc7G27LJBnLwHIDb7h7KdFk7Epk9PQHf7jt00pSqNj-wi996hCXy0ShrfIKuMbkN_8zSxGdrT6zUzeoUL8VX_k",
        // 더미 데이터 크론이 채울 대상 테넌트(slug 또는 이름, 대소문자
        // 무관). 비워두거나 지우면 크론이 아무것도 하지 않고 건너뛴다.
        "DEV_SEED_TENANT_SLUG": "1test"
        // 거래처 포털 전용 서브도메인(src/proxy.ts)을 쓰려면 여기에
        // "PORTAL_HOSTNAME": "portal.elvonix.co.kr" 를 추가한다 — 일부러
        // 기본값을 비워둔다. 먼저 Cloudflare 대시보드 > Workers & Pages >
        // elvonix-erp-dev > Settings > Domains & Routes에서 이 호스트명을
        // Custom Domain으로 추가해 실제로 이 Worker가 그 주소를 받게
        // 만든 "다음에" 이 값을 넣어야 한다 — 순서가 바뀌면(이 값부터
        // 먼저 배포되면) 기존 app 도메인에서 /portal/*로 들어오는 요청이
        // 아직 연결 안 된 포털 주소로 리다이렉트되며 끊긴다.
      }
    },
    "production": {
      "name": "elvonix-erp",
      // 운영에는 더미데이터 크론 자체를 안 둔다(triggers 생략) — 코드
      // 상으로도 DEV_SEED_TENANT_SLUG를 안 넣어서 혹시 크론이 돌아도
      // worker.ts가 조용히 건너뛰게 이중으로 막혀 있다.
      "vars": {
        "NEXT_PUBLIC_SUPABASE_URL": "https://bqetemkilbtjjbgywmbp.supabase.co",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJxZXRlbWtpbGJ0ampiZ3l3bWJwIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODMyMDkzNzgsImV4cCI6MjA5ODc4NTM3OH0.nUasjmfaisANmU9z_zSoQuVIryOQaZrcrT80a5vwcf0",
        "NEXT_PUBLIC_VAPID_PUBLIC_KEY": "BOc7G27LJBnLwHIDb7h7KdFk7Epk9PQHf7jt00pSqNj-wi996hCXy0ShrfIKuMbkN_8zSxGdrT6zUzeoUL8VX_k"
      }
    }
  }
}

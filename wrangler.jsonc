{
  "name": "elvonix-erp",
  // 기본 OpenNext 워커(.open-next/worker.js)에 scheduled() 핸들러를 얹은
  // 커스텀 워커 — worker.ts 참고. fetch 처리는 그대로 위임되므로 앱
  // 동작에는 영향이 없고, 매일 크론(아래 triggers)만 추가로 처리한다.
  "main": "worker.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // 더미(테스트용) 직원/게시글을 매일 자동으로 채워주는 크론 —
  // 한국시간 새벽 6시(UTC 21:00, 전날 기준). DEV_SEED_TENANT_SLUG가
  // 설정된 테넌트에만 적용되며, 대상을 바꾸려면 아래 vars의 값만
  // 고치면 된다(worker.ts의 scheduled() 핸들러 참고).
  "triggers": {
    "crons": ["0 21 * * *"]
  },
  // Workers Logs(대시보드 Observability > Logs/실시간 이벤트)가 이 블록
  // 없이는 아예 아무 이벤트도 수집하지 않는다 — "Waiting for events..."만
  // 계속 뜨던 이유가 크래시를 놓친 게 아니라 로깅 자체가 꺼져있었기
  // 때문이었다. 이제 이 Worker의 모든 요청/console.error 출력이 실제로
  // 수집된다.
  "observability": {
    "enabled": true
  },
  // NEXT_PUBLIC_ 접두사가 붙은 값은 원래 브라우저로 그대로 노출되는
  // 값이라(빌드 시점에 클라이언트 JS에 박힘) 여기 커밋해도 새로운 노출이
  // 아니다. 대시보드(Settings > Variables and Secrets)에 넣은 값이
  // 이 배포 설정 파일이 있는 Worker에는 실제로 안 묶이는 문제가 있어,
  // 확실하게 묶이도록 여기 직접 선언한다. SUPABASE_SERVICE_ROLE_KEY처럼
  // 진짜 민감한 값은 여기 넣지 않고 대시보드의 "Secret" 타입으로 넣는다.
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://bqetemkilbtjjbgywmbp.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJxZXRlbWtpbGJ0ampiZ3l3bWJwIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODMyMDkzNzgsImV4cCI6MjA5ODc4NTM3OH0.nUasjmfaisANmU9z_zSoQuVIryOQaZrcrT80a5vwcf0",
    // 브라우저 푸시 알림용 VAPID 공개키 — 이 값 자체는 브라우저로 노출돼도
    // 안전하다(공개키). 짝을 이루는 VAPID_PRIVATE_KEY는 여기 넣지 않고
    // Cloudflare 대시보드에서 "Secret"으로 등록한다(SUPABASE_SERVICE_ROLE_KEY와
    // 같은 방식).
    "NEXT_PUBLIC_VAPID_PUBLIC_KEY": "BOc7G27LJBnLwHIDb7h7KdFk7Epk9PQHf7jt00pSqNj-wi996hCXy0ShrfIKuMbkN_8zSxGdrT6zUzeoUL8VX_k",
    // 더미 데이터 크론이 채울 대상 테넌트(slug 또는 이름, 대소문자 무관).
    // 비워두거나 지우면 크론이 아무것도 하지 않고 건너뛴다.
    "DEV_SEED_TENANT_SLUG": "Elvonix"
    // 거래처 포털 전용 서브도메인(src/proxy.ts)을 쓰려면 여기에
    // "PORTAL_HOSTNAME": "portal.elvonix.co.kr" 를 추가한다 — 일부러
    // 기본값을 비워둔다. 먼저 Cloudflare 대시보드 > Workers & Pages >
    // elvonix-erp > Settings > Domains & Routes에서 이 호스트명을
    // Custom Domain으로 추가해 실제로 이 Worker가 그 주소를 받게
    // 만든 "다음에" 이 값을 넣어야 한다 — 순서가 바뀌면(이 값부터
    // 먼저 배포되면) 기존 app 도메인에서 /portal/*로 들어오는 요청이
    // 아직 연결 안 된 포털 주소로 리다이렉트되며 끊긴다.
  }
}

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 관리자가 새 계정을 만들 때만 필요 (환경설정 > 권한관리). Supabase 대시보드 >
# Project Settings > API > service_role 에서 복사. 서버에서만 쓰이며 절대
# 브라우저로 노출되지 않는다.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# (선택) 환경설정 > 백업/복원 > "재해복구(서버에서 시점 복원)" 화면을 쓰려면
# 필요하다. 이 저장소 전용 GitHub fine-grained PAT — 권한은 Actions:
# Read and write, Contents: Read-only만 준다. 없으면 그 화면은 안내
# 문구만 보여주고 조용히 꺼져 있는다. 절차는 docs/db-backup-restore.md 참고.
GITHUB_RESTORE_TOKEN=your-github-fine-grained-pat

# (선택) /demo 접속 시 아이디/비밀번호 없이 자동으로 로그인시켜줄 데모
# 계정의 자격증명. 플랫폼 관리 > 고객사 > (해당 회사) 상세 화면의
# "+ 데모 계정 추가"로 만든 계정의 이메일/비밀번호를 그대로 넣는다(아이디만
# 정했다면 이메일은 "그아이디@<회사슬러그>.elvonix.local"). 없으면 /demo는
# 로그인 화면으로 안내만 하고 조용히 꺼져 있는다.
DEMO_LOGIN_EMAIL=demo@osungtech.local
DEMO_LOGIN_PASSWORD=your-demo-account-password

# (선택) 결재 요청/승인/반려 브라우저 푸시 알림. `npx web-push generate-vapid-keys`로
# 한 쌍 생성해서 넣는다. 공개키는 클라이언트로 노출돼도 안전하고, 비밀키는
# 서버 전용이다. 둘 다 없으면 알림 종의 "브라우저 알림 켜기" 버튼이 조용히
# 숨겨지고 나머지 화면은 그대로 동작한다.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# (선택) 그룹웨어 메일함을 5분 주기로 백그라운드 동기화하려면 필요하다
# (.github/workflows/mail-sync.yml). 직접 정한 임의의 긴 문자열(예:
# openssl rand -hex 32) — GitHub 저장소 Secrets의 CRON_SECRET과 반드시
# 같은 값이어야 한다. 없으면 그 크론만 조용히 401을 돌려주고, 탭이 열려
# 있는 동안의 짧은 주기 자동 확인(메신저/알림 위젯)은 그대로 동작한다.
CRON_SECRET=your-cron-secret

# (선택) 거래처 포털을 별도 서브도메인으로 분리하려면 설정한다
# (src/proxy.ts). 로컬 개발에선 보통 비워두고 localhost:3000/portal/...로
# 그대로 테스트한다 — 설정 안 하면 아무 것도 안 바뀐다.
PORTAL_HOSTNAME=portal.elvonix.co.kr
